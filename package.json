{
  "name": "audit-service",
  "version": "1.0.0",
  "type": "module",
  "main": "bin/audit-service.js",
  "scripts": {
    "dev": "nodemon --watch src --watch bin --ext js,json --exec node bin/audit-service.js",
    "start": "node bin/audit-service.js",
    "start:dev": "cross-env NODE_ENV=development node bin/audit-service.js",
    "start:staging": "cross-env NODE_ENV=staging node bin/audit-service.js",
    "start:prod": "cross-env NODE_ENV=production node bin/audit-service.js",
    "db:migrate": "node src/db/migrate.js"
  },
  "dependencies": {
    "@membership/policy-middleware": "git+https://github.com/kashif147/policy-middleware.git#gateway",
    "@projectShell/rabbitmq-middleware": "github:kashif147/rabbitmq-middleware#gateway",
    "compression": "^1.7.4",
    "cors": "^2.8.5",
    "dotenv-flow": "^3.3.0",
    "express": "^4.19.2",
    "express-rate-limit": "^7.4.0",
    "helmet": "^7.1.0",
    "pg": "^8.12.0",
    "pino": "^9.2.0",
    "pino-http": "^10.1.0",
    "pino-pretty": "^13.1.1",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.1"
  },
  "devDependencies": {
    "cross-env": "^10.0.0",
    "nodemon": "^3.0.1"
  }
}
