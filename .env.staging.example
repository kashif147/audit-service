PORT=4006
NODE_ENV=staging

# Same Postgres host/credentials as reporting-service; separate database.
POSTGRES_DB=audit_db
POSTGRES_USER=reports_admin
POSTGRES_PASSWORD=your_password_here
POSTGRES_URI=postgresql://reports_admin:your_password_here@reporting-postgres:5432/audit_db

# Resolve audit actor ids to CRM user names (internal Docker network).
USER_SERVICE_URL=http://user-service:3000/api
PROFILE_SERVICE_URL=http://profile-service:3000/api
SUBSCRIPTION_SERVICE_URL=http://subscription-service:3000/api
ACCOUNT_SERVICE_URL=http://account-service:3000/api
